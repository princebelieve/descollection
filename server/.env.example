# Existing deployment values
PORT=4000
CLIENT_URL=https://descollection.co.uk
MONGO_URI=
JWT_SECRET=
ADMIN_EMAILS=admin@descollection.co.uk
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Gmail API OAuth2 refresh token for sending account emails; request gmail.send scope.
# This may use the same Google Cloud Web OAuth client as GOOGLE_CLIENT_ID below.
GMAIL_USER=descollection100@gmail.com
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Meta WhatsApp Cloud API order notifications (server-side only; never put these in VITE_* vars).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Admin recipient in international format without +, spaces or punctuation.
WHATSAPP_ORDER_RECIPIENT=
# Create and get approval for a utility template with seven body placeholders.
WHATSAPP_ORDER_TEMPLATE_NAME=new_paid_order
WHATSAPP_TEMPLATE_LANGUAGE=en_GB
# Approved customer order-copy template: body placeholders are customer name, order reference, total, items.
WHATSAPP_CUSTOMER_ORDER_TEMPLATE_NAME=des_collection_customer_order_copy
WHATSAPP_CUSTOMER_TEMPLATE_LANGUAGE=en_GB
# Meta's latest supported Graph API version as of this setup; update when Meta versions it out.
WHATSAPP_GRAPH_API_VERSION=v26.0
# Meta webhook verification and request-signature validation. Use the app secret from Meta App Settings > Basic.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Google Identity Services Web OAuth client ID (same value as VITE_GOOGLE_CLIENT_ID).
GOOGLE_CLIENT_ID=
VITE_STRIPE_PUBLISHABLE_KEY=
