# Set to the deployed API origin when the frontend and backend are hosted separately.
VITE_API_URL=https://descollection.onrender.com

# Google Identity Services Web OAuth client ID; also set as GOOGLE_CLIENT_ID on Render.
VITE_GOOGLE_CLIENT_ID=

# Stripe publishable key for embedded checkout (enable eligible payment methods in Stripe).
VITE_STRIPE_PUBLISHABLE_KEY=
